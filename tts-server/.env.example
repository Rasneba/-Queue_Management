# Optional: expose database health. Does nothing if DATABASE_URL is not set.

# Optional: point the service at a PostgreSQL/Neon database. Enables accounts,
# credits, usage, API keys and synthesis history. Leave empty for a UI-only setup.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: session lifetime in days (default 30).
SESSION_TTL_DAYS=30

# Optional: TTS synthesis engine.
#   edge      = Microsoft Edge neural voices (default, commercial OK, needs network)
#   mms_onnx  = offline facebook/mms-tts-amh via ONNX Runtime.
#               CC-BY-NC 4.0 -> NON-COMMERCIAL, benchmark/demo only.
#   auto      = use mms_onnx only if its model files are present, else edge.
TTS_ENGINE=edge

# Only used when TTS_ENGINE=mms_onnx. Folder containing model.onnx,
# vocab.json and meta.json (exported from facebook/mms-tts-amh).
# MMS_ONNX_PATH=C:/models/mms-tts-amh
# MMS_LANG=am
# MMS_THREADS=2

# Optional: /transcribe speech-to-text (faster-whisper, only if installed).
# STT_MODEL=tiny|base|small|medium|large-v3 (default small, ~500MB download)
# STT_DEVICE=auto|cpu|cuda, STT_COMPUTE=default|int8|float16
STT_MODEL=small
STT_DEVICE=auto
